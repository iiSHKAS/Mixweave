{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixweave",
  "version": "0.5.1",
  "identifier": "dev.sonux.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Mixweave",
        "width": 1403,
        "height": 880,
        "minWidth": 1015,
        "minHeight": 822,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "$HOME/.local/share/icons/**",
          "$HOME/.local/share/flatpak/exports/share/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "copyright": "Copyright Sink, Sonux and Mixweave contributors",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/GPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "vendor/LICENSE": "licenses/PIPEWIRE_RS_MIT.txt",
      "../third_party/licenses/APACHE-2.0.txt": "licenses/APACHE-2.0.txt",
      "../third_party/licenses/RNNOISE_BSD-3-Clause.txt": "licenses/RNNOISE_BSD-3-Clause.txt",
      "../third_party/licenses/WEBRTC_SONORA_BSD-3-Clause.txt": "licenses/WEBRTC_SONORA_BSD-3-Clause.txt",
      "../src/styles/fonts/LICENSE.txt": "licenses/FIRA_CODE_LICENSE.txt",
      "../src-tauri/assets/test-audio/LICENSES.md": "licenses/TEST_AUDIO_LICENSES.md",
      "../third_party/spatial/licenses/AALTO_HRTF_ATTRIBUTION.md": "licenses/AALTO_HRTF_ATTRIBUTION.md"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libfftw3-single3",
          "libmysofa1",
          "pulseaudio-utils",
          "pipewire-pulse",
          "wireplumber"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator3.so.1()(64bit)",
          "pulseaudio-utils",
          "pipewire-pulseaudio",
          "wireplumber"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNThCREUzQTRFNjA3MQpSV1J4WUU0NjNvdjFDb1RaQVdBQXp4REY2VS9sR0RhaFpWeVJONUMrRkpRRFA5clhwbGFodFRHZQo=",
      "endpoints": [
        "https://github.com/iishkas/Mixweave/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
