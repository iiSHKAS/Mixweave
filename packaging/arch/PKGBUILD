# Maintainer: Mixweave contributors
pkgname=mixweave-bin
pkgver=0.5.1
pkgrel=1
pkgdesc="PipeWire gaming audio router, mixer, and microphone processor"
arch=('x86_64')
url="https://github.com/iishkas/Mixweave"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'glib2' 'gtk3' 'gdk-pixbuf2' 'cairo' 'dbus'
         'webkit2gtk-4.1' 'libsoup3' 'libpipewire' 'pipewire-pulse'
         'wireplumber' 'libmysofa' 'fftw' 'hicolor-icon-theme'
         'libayatana-appindicator')
provides=('mixweave')
conflicts=('sonux-bin' 'sonux')
options=('!strip' '!debug')
source=('mixweave.deb')
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  bsdtar -xf mixweave.deb
  bsdtar --no-same-owner -xf data.tar.* -C "$pkgdir"
}
